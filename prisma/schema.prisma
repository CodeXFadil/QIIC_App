generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Zone {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  memberCount Int      @default(0)
  latitude    Float?   // optional — set from admin panel
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         String   @default("viewer") // "admin" | "viewer"
  name         String?
  createdAt    DateTime @default(now())
}
